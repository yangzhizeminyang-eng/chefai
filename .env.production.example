# =====================================================================
# 文件名: .env.production.example
# 用途:   生产部署变量，供 `docker compose --env-file .env.production` 做变量插值。
#
# 使用:   cp .env.production.example .env.production  →  填入真实值
#
# 🔴 安全要求:
#   1. .env.production 含明文口令，禁止提交版本库（.gitignore 已忽略，见下方说明）
#   2. 禁止打进任何镜像（根 .dockerignore 已排除 .env.production）
#   3. 本文件中的示例值全部为占位符，直接照抄上线等于裸奔
#
# 注意:   后端的大模型 / 视觉 / 向量配置**不在本文件**，由 docker-compose.yml
#         的 `env_file: ./backend/.env` 提供，模板见 backend/.env.example。
# =====================================================================

# ---------- 对外端口（宿主端口 → 容器 nginx 80） ----------
WEB_PORT=8005

# ---------- 前端镜像 tag（必须与本地 `docker build -f Dockerfile.web -t <tag>` 一致） ----------
WEB_IMAGE=aicook-web:20261013

# ---------- 数据库口令 ----------
# 对应 docker-compose.yml 中 db 服务的 POSTGRES_PASSWORD，
# POSTGRES_USER=postgres、POSTGRES_DB=aicook 保持不变。
# ⚠️ 只用字母 / 数字 / - _ . 等无需转义的字符：该值会同时进入
#    YAML、容器环境变量与 psycopg 连接串，出现 $ " ' @ : / 可能解析异常。
DB_PASSWORD=CHANGE_ME_数据库强口令_至少16位

# ---------- 管理后台 ----------
# 管理后台登录口令（默认账号 admin / 访问路径 /admin/）
ADMIN_PASSWORD=CHANGE_ME_后台强口令_至少16位

# JWT 签名密钥（登录态签名，泄露等于后台可被伪造）
# 生成方式：openssl rand -hex 32
ADMIN_JWT_SECRET=CHANGE_ME_32字节以上随机串

# =====================================================================
# 生产环境下建议同时核对 backend/.env 的以下取值（模板见 backend/.env.example）：
#   APP_PORT=8000            容器内 uvicorn 端口，与 compose 保持一致，勿改
#   VISION_PROVIDER=vlm      真实视觉识别（mock 仅用于无外部依赖的演示）
#   SPEECH_PROVIDER=bailian  真实语音转写（🔴 缺省 mock 会返回固定演示文本）
#   TTS_PROVIDER=bailian     真实语音合成（🔴 缺省 mock 会返回静音）
#   VOICE_INTENT_ENABLED=on  语音意图的 LLM 兜底解析（off = 纯白名单）
#   COOKING_HELP_AGENT_ENABLED=on  烹饪求助子智能体（off = 关键词模板兜底）
#   EMBEDDING_PROVIDER=hash  阶段一确定性哈希，零外部调用与成本；
#                            切 bailian 前必须评估 embedding_space_version
#                            全量重建，否则新旧向量空间混存会静默出错
#   RETRIEVAL_VECTOR=on      向量召回总开关
# ⚠️ 上述 Provider 取 mock 时接口不会报错，只会静默返回演示内容 ——
#    上线前务必确认已切到真实 Provider，否则体验上等同功能不可用。
# =====================================================================
