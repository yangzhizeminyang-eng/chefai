{
  "name": "ai-cook-mini",
  "version": "0.1.0",
  "private": true,
  "description": "AI 厨娘微信小程序（uni-app Vue3 + Vite + TypeScript + Pinia）",
  "scripts": {
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "check:api": "node scripts/check-browser-api.mjs",
    "audit:size": "node scripts/size-audit.mjs",
    "icons": "node ../scripts/gen-tab-icons.mjs"
  },
  "uni-app": {
    "scripts": {}
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
    "@vue/runtime-core": "^3.4.21",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-i18n": "^9.1.9"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-automator": "3.0.0-5020620260917001",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@uni-helper/uni-app-types": "^0.5.13",
    "sass": "^1.77.8",
    "typescript": "~5.6.3",
    "vite": "^5.2.8",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.10"
