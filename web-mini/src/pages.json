        { "path": "shopping", "style": { "navigationBarTitleText": "购物清单" } }
      ]
    },
    {
      "root": "pages/member",
      "pages": [
        { "path": "signature", "style": { "navigationBarTitleText": "签名定制" } },
        { "path": "settings", "style": { "navigationBarTitleText": "设置" } },
        { "path": "about", "style": { "navigationBarTitleText": "关于" } },
        { "path": "center", "style": { "navigationBarTitleText": "会员中心" } },
        { "path": "benefits", "style": { "navigationBarTitleText": "会员权益" } },
        { "path": "orders", "style": { "navigationBarTitleText": "我的订单" } },
        { "path": "feedback", "style": { "navigationBarTitleText": "意见反馈" } }
      ]
    },
    {
      "root": "pages/innovation",
      "pages": [
        { "path": "entry", "style": { "navigationBarTitleText": "AI 创新" } },
        { "path": "confirm", "style": { "navigationBarTitleText": "创新确认" } },
        { "path": "result", "style": { "navigationBarTitleText": "创新结果" } },
        { "path": "detail", "style": { "navigationBarTitleText": "创新详情" } },
        { "path": "mine", "style": { "navigationBarTitleText": "我的创新" } }
      ]
    }
