  "preloadRule": {
    "pages/index/index": { "network": "all", "packages": ["pages/recommend"] },
    "pages/recommend/detail": { "network": "all", "packages": ["pages/cooking", "pages/innovation"] },
    "pages/cooking/finish": { "network": "all", "packages": ["pages/nutrition"] },
    "pages/me/index": { "network": "all", "packages": ["pages/member"] }
  },
  "tabBar": {
    "custom": false,
    "color": "@tabFontColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBgColor",
    "borderStyle": "@tabBorderStyle",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/tab/home.png",
        "selectedIconPath": "static/tab/home-active.png"
      },
      {
        "pagePath": "pages/fridge/index",
        "text": "我的冰箱",
        "iconPath": "static/tab/fridge.png",
        "selectedIconPath": "static/tab/fridge-active.png"
      },
      {
        "pagePath": "pages/favorites/index",
        "text": "收藏·历史",
        "iconPath": "static/tab/fav.png",
        "selectedIconPath": "static/tab/fav-active.png"
      },
      {
        "pagePath": "pages/me/index",
        "text": "我的",
        "iconPath": "static/tab/me.png",
        "selectedIconPath": "static/tab/me-active.png"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTitleText": "AI 厨娘",
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTextStyle": "@navTxtStyle",
    "backgroundColor": "@bgColor",
    "backgroundTextStyle": "@bgTxtStyle",
    "darkmode": true,
    "themeLocation": "theme.json",
    "rpxCalcMaxDeviceWidth": 960
  }
}
