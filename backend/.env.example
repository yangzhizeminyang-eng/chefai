# ========== AI 厨娘・智能烹饪助手 阶段一后端环境配置（示例，复制为 .env 后填写真实值） ==========
# 数据库（PostgreSQL 16）
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=aicook

# 大模型（OpenAI 兼容协议）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=20

# 视觉模型（VLM，OpenAI 兼容协议；VISION_PROVIDER 取 mock（缺省）/ vlm（真实识别））
VISION_PROVIDER=mock
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VISION_MODEL=qwen3.8-omni-flash
VISION_TIMEOUT_SECONDS=20
VISION_MAX_ITEMS=12

# 应用服务
APP_HOST=0.0.0.0
APP_PORT=8000
