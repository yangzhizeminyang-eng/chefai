# ========== AI 厨娘・智能烹饪助手 阶段一后端环境配置（示例，复制为 .env 后填写真实值） ==========
# 数据库（PostgreSQL 16）
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=aicook

# 大模型（OpenAI 兼容协议）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=20

# 视觉模型（VLM，OpenAI 兼容协议；VISION_PROVIDER 取 mock（缺省）/ vlm（真实识别））
VISION_PROVIDER=mock
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VISION_MODEL=qwen3.8-omni-flash
VISION_TIMEOUT_SECONDS=20
VISION_MAX_ITEMS=12

# 语音转写（百炼 qwen3-asr-flash，OpenAI 兼容协议；BASE/KEY 缺省回落 VISION_*）
# SPEECH_PROVIDER 取 mock（缺省，固定演示文本）/ bailian（百炼真实语音识别）
SPEECH_PROVIDER=mock
SPEECH_BASE_URL=
SPEECH_API_KEY=
SPEECH_MODEL=qwen3-asr-flash
SPEECH_TIMEOUT_SECONDS=15

# 向量嵌入（阿里云百炼 qwen3.7-text-embedding，OpenAI 兼容协议；API BASE/KEY 缺省回落 VISION_*）
# EMBEDDING_PROVIDER 取 hash（缺省，确定性哈希兜底）/ bailian（百炼远程语义嵌入）
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL_NAME=qwen3.7-text-embedding
EMBEDDING_BATCH_SIZE=10
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=10
EMBEDDING_WARMUP=on
# 检索开关：RETRIEVAL_VECTOR 向量路径总开关；RETRIEVAL_VECTOR_FOR_INGREDIENTS 手选食材合成查询（默认 off）
# RETRIEVAL_FUSION 三路融合策略（fixed 缺省 / rrf）
RETRIEVAL_VECTOR=on
RETRIEVAL_VECTOR_FOR_INGREDIENTS=off
RETRIEVAL_FUSION=fixed

# 应用服务
APP_HOST=0.0.0.0
APP_PORT=8000

# 运维提示：pgvector ivfflat 索引 lists 参数建议随数据量校正（lists ≈ √n），
# 当前 ≈400 行建议 lists=20；属 REINDEX 运维动作不进应用迁移：
#   DROP INDEX idx_emb_vector; CREATE INDEX idx_emb_vector ON recipe_embedding
#   USING ivfflat (embedding vector_cosine_ops) WITH (lists = 20);
