# =====================================================================
# 文件名: Dockerfile.web（项目根）
# 用途:   「AI 厨娘」单镜像托管两套前端 + nginx 反代（决策：采用根级单镜像方案，
#         不在 web-stage1 / admin-web 各自目录重复建 Dockerfile）
#         - web-build 阶段：node:20-alpine 构建 web-stage1（npm ci && npm run build）；
#         - admin-build 阶段：node:20-alpine 构建 admin-web，附加 --base=/admin/
#           使静态资源落在 /admin/assets/*，适配 nginx 子路径托管（不改动业务源码）；
#         - nginx:alpine 运行层：web-stage1/dist → /usr/share/nginx/html/web（location /），
#           admin-web/dist → /usr/share/nginx/html/admin（location /admin/），
#           /v1、/api、/admin/v1 反代 api:8000（配置见 nginx/nginx.conf）。
# 构建:   docker build -f Dockerfile.web -t aicook-web .   （构建上下文=项目根）
# =====================================================================

# ---------- web-stage1：用户端（默认 base=/，托管于 location /） ----------
# 基础镜像走 docker.m.daocloud.io 加速前缀（当前网络直连 Docker Hub 被劫持，registry
# 元数据返回 text/html）；如需官方源，删除前缀改回 node:20-alpine / nginx:alpine 即可
FROM docker.m.daocloud.io/library/node:20-alpine AS web-build
WORKDIR /src/web
COPY web-stage1/package.json web-stage1/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web-stage1/ ./
RUN npm run build

# ---------- admin-web：管理后台（--base=/admin/ 使资源路径与托管路径一致） ----------
FROM docker.m.daocloud.io/library/node:20-alpine AS admin-build
WORKDIR /src/admin
COPY admin-web/package.json admin-web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY admin-web/ ./
# 不经 npm-run-all2 的 run-p 包装（"build" 脚本不透传附加参数），直接调 build-only
# 以保证 --base=/admin/ 到达 vite CLI；type-check 质量门单独执行
RUN npm run type-check && npm run build-only -- --base=/admin/

# ---------- nginx 运行层：双前端静态 + API 反代 ----------
FROM docker.m.daocloud.io/library/nginx:alpine
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=web-build /src/web/dist /usr/share/nginx/html/web
COPY --from=admin-build /src/admin/dist /usr/share/nginx/html/admin
EXPOSE 80
